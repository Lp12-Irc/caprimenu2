file(READ "${HEADER}" contents)
string(REGEX MATCH "CAPRI_CLIENT_BUILD=([0-9]+)" build_match "${contents}")
set(build "${CMAKE_MATCH_1}")
string(REGEX MATCH "CAPRI_CLIENT_VERSION=\"([^\"]+)\"" version_match "${contents}")
set(version "${CMAKE_MATCH_1}")
if(NOT build OR NOT version)
  message(FATAL_ERROR "Missing client version")
endif()
file(SHA256 "${EXE}" digest)
get_filename_component(directory "${EXE}" DIRECTORY)
file(WRITE "${directory}/client-version.json" "{\"build\":${build},\"version\":\"${version}\",\"sha256\":\"${digest}\"}\n")
