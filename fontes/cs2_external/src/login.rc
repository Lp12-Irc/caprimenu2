#include <windows.h>
101 DIALOGEX 0, 0, 264, 184
STYLE DS_SETFONT | WS_POPUP | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Capri - Acesso"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "CAPRI", 1003, 36, 12, 170, 13
    LTEXT "ACESSO", 1008, 36, 26, 170, 10
    CONTROL "X", 1007, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 230, 10, 18, 18
    LTEXT "Entre no Capri.", 1004, 20, 45, 224, 22
    LTEXT "Use sua chave para continuar.", 1005, 20, 70, 224, 14
    LTEXT "CHAVE DE ACESSO", 1006, 20, 96, 224, 10
    CONTROL "", 1001, "EDIT", ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP, 26, 116, 180, 15
    CONTROL "Mostrar chave", 1010, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 216, 112, 24, 22
    LTEXT "Ctrl + V para colar sua chave.", 1002, 20, 140, 224, 20
    CONTROL "Entrar no Capri", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 20, 160, 160, 22
    CONTROL "Cancelar", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 190, 160, 54, 22
    LTEXT "CLIENTE WINDOWS", 1009, 20, 184, 224, 10
END
