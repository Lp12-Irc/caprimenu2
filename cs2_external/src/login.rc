#include <windows.h>
101 DIALOGEX 0, 0, 310, 150
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HillBlack - Acesso"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "HillBlack", -1, 16, 12, 275, 16
    LTEXT "Digite sua key para entrar.", -1, 16, 34, 275, 14
    EDITTEXT 1001, 16, 53, 278, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Cole a key com Ctrl+V e clique em Entrar.", 1002, 16, 82, 278, 27
    DEFPUSHBUTTON "Entrar", IDOK, 139, 119, 75, 20
    PUSHBUTTON "Cancelar", IDCANCEL, 219, 119, 75, 20
END
